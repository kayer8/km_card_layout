.clm-card-layout {
  position: relative;
  border-radius: 32rpx;
  overflow: hidden;
  color: #f6f7fb;
  font-family: 'PingFang SC', 'Microsoft Yahei', sans-serif;
}

.clm-card-element {
  position: absolute;
  box-sizing: border-box;
  color: inherit;
}

.clm-card-element--text {
  display: block;
  line-height: 1.3;
  overflow: hidden;
}

.clm-card-element--image {
  width: 100%;
  height: 100%;
  border-radius: inherit;
}

.clm-card-element--icon {
  border-radius: 50%;
  justify-content: center;
  align-items: center;
}

.clm-card-icon-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.clm-card-iconfont {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-family: 'km-icon';
  font-size: 100%;
  line-height: 1;
}

.clm-card-icon-dot {
  display: inline-block;
  width: 100%;
  height: 100%;
}
